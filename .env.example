# --- WhatsApp Cloud API (Meta for Developers > Glo Messenger app > WhatsApp > API Setup) ---
# Permanent token from the system user (Business Settings > Users > System Users > Generate token).
# Needs whatsapp_business_messaging and whatsapp_business_management permissions.
WHATSAPP_TOKEN=

# The Phone Number ID for +91 91012 09309 (found via WhatsApp Manager > Phone numbers, or the
# API Setup screen). This is an ID, not a secret, but keep it in .env for consistency.
WHATSAPP_PHONE_NUMBER_ID=1687556379005979

# Graph API version to call. Bump this occasionally; Meta deprecates old versions.
WHATSAPP_GRAPH_VERSION=v21.0

# A string you make up yourself and enter into Meta's webhook config screen (Configure Webhooks >
# Verify token). Meta echoes it back on the verification GET request; this backend checks it matches.
WHATSAPP_VERIFY_TOKEN=change-this-to-a-random-string

# --- Gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Google Sheets logging (the "Glo Leads 2026 (New) V1" CRM sheet) ---
# Sheet ID is the long string in the sheet's URL between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=1tWfRMsbzLpiC15gpA4dH9zKQDW9hc6AJK2zDM0AwPZk
# Both of the tabs below are created automatically (with a header row) on first use if they don't
# already exist - safe to point this at any spreadsheet the service account has Editor access to,
# without pre-making tabs by hand.
GOOGLE_SHEETS_TAB_NAME=Admission Queries
# A second tab holding one row per parent phone number with a running plain-English summary of
# that whole conversation (separate from the per-message log above).
GOOGLE_SHEETS_CONVERSATIONS_TAB_NAME=Conversations

# Path to a Google Cloud service-account JSON key file (see README for how to create one and
# share the sheet with its email address). Used for LOCAL DEV only. Never commit this file.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# For PRODUCTION hosts with no persistent disk (e.g. Render free tier): paste the entire contents
# of the service-account JSON key file into this single-line env var instead of using a file. If
# this is set, it's used instead of GOOGLE_SERVICE_ACCOUNT_KEY_PATH above.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# --- Conversation memory (Postgres) ---
# Lets the bot remember earlier messages in the same WhatsApp conversation instead of answering
# each message in isolation. Create a free Postgres instance in Render's dashboard and paste its
# "Internal Database URL" here (use the "External Database URL" for local dev instead).
DATABASE_URL=

# --- Server ---
PORT=3000

# Escalation number quoted in scripted fee/handoff replies (E.164 or local format, as parents should dial it).
ESCALATION_PHONE=6001819309
